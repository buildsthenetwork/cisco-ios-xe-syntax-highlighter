!
! ============================================================
! LOCAL USERS / ENABLE SECRETS
! ============================================================
!
enable password PlainTextEnablePassword
enable password 7 030752180500
enable secret MyEnableSecret
enable secret 5 $1$FAKEHASH$abcdefghijklmnopqrstuv
enable secret 8 $8$FAKESALT$abcdefghijklmnopqrstuvwxyz0123456789
enable secret 9 $9$FAKESALT$abcdefghijklmnopqrstuvwxyz0123456789
!
username admin password PlainTextPassword
username admin2 password 0 PlainTextPassword123
username admin3 password 7 08314D5D1A48
username engineer privilege 15 secret MySecretPassword
username engineer2 privilege 15 secret 5 $1$FAKE$abcdefghijklmnopqrstuv
username engineer3 privilege 15 secret 8 $8$FAKE$abcdefghijklmnopqrstuvwxyz
username engineer4 privilege 15 secret 9 $9$FAKE$abcdefghijklmnopqrstuvwxyz
!
username test-user privilege 5 password 0 P@ssw0rd-With-Specials!
username quoted-user privilege 15 secret 0 "Password With Spaces!"
!
! ============================================================
! AAA / RADIUS
! ============================================================
!
aaa new-model
!
radius server ISE-01
 address ipv4 10.10.10.10 auth-port 1812 acct-port 1813
 key RadiusSharedSecret123!
!
radius server ISE-02
 address ipv4 10.10.10.11 auth-port 1812 acct-port 1813
 key 0 PlainTextRadiusKey
!
radius server ISE-03
 address ipv4 10.10.10.12 auth-port 1812 acct-port 1813
 key 7 030752180500
!
aaa group server radius ISE-RADIUS
 server name ISE-01
 server name ISE-02
!
ip radius source-interface Loopback0
!
! Older-style RADIUS syntax worth recognizing
!
radius-server host 10.20.20.10 auth-port 1812 acct-port 1813 key LegacyRadiusKey
radius-server host 10.20.20.11 key 7 060506324F41
radius-server key GlobalRadiusSecret
!
! ============================================================
! TACACS+
! ============================================================
!
tacacs server TACACS-01
 address ipv4 10.30.30.10
 key TacacsSharedSecret123!
!
tacacs server TACACS-02
 address ipv4 10.30.30.11
 key 0 PlainTextTacacsKey
!
tacacs server TACACS-03
 address ipv4 10.30.30.12
 key 7 104D000A0618
!
aaa group server tacacs+ TACACS-GROUP
 server name TACACS-01
 server name TACACS-02
!
ip tacacs source-interface Loopback0
!
! Legacy TACACS+ forms
!
tacacs-server host 10.40.40.10 key LegacyTacacsSecret
tacacs-server host 10.40.40.11 key 7 02050D480809
tacacs-server key GlobalTacacsSecret
!
! ============================================================
! SNMP
! ============================================================
!
snmp-server community PublicReadString RO
snmp-server community PrivateWriteString RW
snmp-server community RestrictedCommunity RO 10
!
snmp-server community "Community With Spaces" RO
!
snmp-server group NMS-GROUP v3 priv
snmp-server group MONITORING v3 auth
!
snmp-server user snmpadmin NMS-GROUP v3 auth sha AuthPassword123 priv aes 128 PrivacyPassword123
snmp-server user monitor MONITORING v3 auth sha AuthOnlyPassword
!
snmp-server user sha256user NMS-GROUP v3 auth sha-256 SHA256AuthPassword priv aes 256 AES256PrivacyPassword
!
snmp-server host 10.50.50.10 version 2c PublicReadString
snmp-server host 10.50.50.20 version 3 priv snmpadmin
!
! ============================================================
! KEY CHAINS
! ============================================================
!
key chain OSPF-AUTH
 key 1
  key-string OSPFSecretKey01
  accept-lifetime 00:00:00 Jan 1 2026 infinite
  send-lifetime 00:00:00 Jan 1 2026 infinite
!
key chain EIGRP-AUTH
 key 10
  key-string 0 EIGRPPlainTextKey
 key 20
  key-string 7 0822455D0A16
!
key chain ROTATING-KEYS
 key 100
  key-string FirstTemporaryKey
  accept-lifetime 00:00:00 Jan 1 2026 23:59:59 Dec 31 2026
  send-lifetime 00:00:00 Jan 1 2026 23:59:59 Dec 31 2026
 key 200
  key-string SecondTemporaryKey
  accept-lifetime 00:00:00 Dec 1 2026 infinite
  send-lifetime 00:00:00 Dec 1 2026 infinite
!
! ============================================================
! OSPF AUTHENTICATION
! ============================================================
!
interface GigabitEthernet1/0/1
 ip ospf authentication
 ip ospf authentication-key OSPFPassword
!
interface GigabitEthernet1/0/2
 ip ospf authentication message-digest
 ip ospf message-digest-key 1 md5 OSPFMD5Password
!
interface TenGigabitEthernet1/1/1
 ip ospf message-digest-key 10 md5 7 030752180500
!
! ============================================================
! EIGRP AUTHENTICATION
! ============================================================
!
interface GigabitEthernet1/0/3
 ip authentication mode eigrp 100 md5
 ip authentication key-chain eigrp 100 EIGRP-AUTH
!
! ============================================================
! BGP AUTHENTICATION
! ============================================================
!
router bgp 65001
 neighbor 192.0.2.1 remote-as 65002
 neighbor 192.0.2.1 password BGPNeighborPassword
 neighbor 192.0.2.2 remote-as 65003
 neighbor 192.0.2.2 password 7 02050D480809
!
 neighbor CORE-PEERS peer-group
 neighbor CORE-PEERS password PeerGroupSecret
!
! ============================================================
! IS-IS AUTHENTICATION
! ============================================================
!
router isis CORE
 net 49.0001.0000.0000.0001.00
 authentication mode md5 level-2
 authentication key-chain ISIS-KEYS level-2
!
key chain ISIS-KEYS
 key 1
  key-string ISISAuthenticationSecret
!
! ============================================================
! NTP AUTHENTICATION
! ============================================================
!
ntp authenticate
ntp authentication-key 1 md5 NTPSecretPassword
ntp authentication-key 2 md5 7 030752180500
ntp trusted-key 1
ntp trusted-key 2
ntp server 192.0.2.100 key 1
!
! ============================================================
! HSRP AUTHENTICATION
! ============================================================
!
interface Vlan100
 standby 100 ip 10.100.0.1
 standby 100 authentication HSRPPassword
!
interface Vlan200
 standby 200 ip 10.200.0.1
 standby 200 authentication md5 key-string HSRP-MD5-Secret
!
interface Vlan300
 standby 300 ip 10.30.0.1
 standby 300 authentication md5 key-chain HSRP-KEYS
!
! ============================================================
! VRRP AUTHENTICATION - useful for legacy syntax testing
! ============================================================
!
interface Vlan400
 vrrp 40 ip 10.40.0.1
 vrrp 40 authentication text VRRPSecret
!
! ============================================================
! GLBP AUTHENTICATION
! ============================================================
!
interface Vlan500
 glbp 50 ip 10.50.0.1
 glbp 50 authentication text GLBPPassword
!
interface Vlan501
 glbp 51 ip 10.51.0.1
 glbp 51 authentication md5 key-string GLBP-MD5-Secret
!
! ============================================================
! IPSEC / IKE / ISAKMP
! ============================================================
!
crypto isakmp policy 10
 encryption aes 256
 hash sha256
 authentication pre-share
 group 14
!
crypto isakmp key SiteToSitePreSharedKey address 192.0.2.50
crypto isakmp key AnotherSecretKey address 198.51.100.10 255.255.255.255
!
crypto keyring VPN-KEYRING
 pre-shared-key address 192.0.2.60 key VPNPeerSecret
 pre-shared-key address 192.0.2.61 key 0 AnotherVPNSecret
!
crypto ikev2 keyring IKEV2-KEYRING
 peer SITE-A
  address 192.0.2.100
  pre-shared-key LocalAndRemoteSecret
 peer SITE-B
  address 192.0.2.101
  pre-shared-key local LocalSecret
  pre-shared-key remote RemoteSecret
!
crypto ikev2 profile IKEV2-PROFILE
 match identity remote address 192.0.2.100 255.255.255.255
 authentication remote pre-share
 authentication local pre-share
 keyring local IKEV2-KEYRING
!
! ============================================================
! DMVPN / NHRP
! ============================================================
!
interface Tunnel100
 ip address 10.255.0.1 255.255.255.0
 ip nhrp authentication DMVPN-NHRP-Key
 ip nhrp network-id 100
 tunnel source GigabitEthernet0/0/0
 tunnel mode gre multipoint
!
! ============================================================
! PPP / CHAP / PAP
! ============================================================
!
username REMOTE-ROUTER password 0 PPPSecret
!
interface Serial0/0/0
 encapsulation ppp
 ppp authentication chap
 ppp chap hostname LOCAL-ROUTER
 ppp chap password 0 ChapSecretPassword
!
interface Serial0/0/1
 encapsulation ppp
 ppp authentication pap
 ppp pap sent-username router01 password 0 PapSecretPassword
!
! ============================================================
! HTTP / HTTPS LOCAL AUTHENTICATION
! ============================================================
!
ip http server
ip http secure-server
ip http authentication local
!
username webadmin privilege 15 secret WebAdminSecret
!
! ============================================================
! FTP CREDENTIALS
! ============================================================
!
ip ftp username backup-user
ip ftp password BackupFTPPassword
!
! ============================================================
! SCP / SSH RELATED CONFIGURATION
! ============================================================
!
ip ssh version 2
ip scp server enable
!
username sshadmin privilege 15 secret SSHLocalAccountSecret
!
! RSA key configuration doesn't contain the private key in normal
! running-config output, but these commands are still useful tests.
!
crypto key generate rsa modulus 2048
crypto key generate rsa label SSH-KEY modulus 3072
!
! ============================================================
! PKI / TRUSTPOINT
! ============================================================
!
crypto pki trustpoint ENTERPRISE-CA
 enrollment url http://pki.example.invalid/certsrv/mscep/mscep.dll
 subject-name CN=router01.example.invalid
 revocation-check crl
 password PKIEnrollmentPassword
!
crypto pki trustpoint SCEP-CA
 enrollment url http://ca.example.invalid/scep
 password 0 SCEPEnrollmentSecret
!
! ============================================================
! DOT1X / 802.1X / RADIUS RELATED
! ============================================================
!
aaa authentication dot1x default group ISE-RADIUS
aaa authorization network default group ISE-RADIUS
aaa accounting dot1x default start-stop group ISE-RADIUS
!
radius server DOT1X-ISE
 address ipv4 10.60.60.10 auth-port 1812 acct-port 1813
 key Dot1xRadiusSecret
!
! ============================================================
! CTS / TRUSTSEC
! ============================================================
!
cts credentials id SWITCH-01 password TrustSecCredentialPassword
!
! ============================================================
! MACSEC / MKA
! ============================================================
!
key chain MKA-KEYCHAIN macsec
 key 01
  cryptographic-algorithm aes-256-cmac
  key-string 0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF
!
mka policy MKA-POLICY
 key-server priority 10
 macsec-cipher-suite gcm-aes-256
!
! ============================================================
! PASSWORD ENCRYPTION / MASTER KEY
! ============================================================
!
service password-encryption
!
key config-key password-encrypt MASTER-ENCRYPTION-PASSWORD
!
password encryption aes
!
! ============================================================
! LDAP
! ============================================================
!
ldap server ENTERPRISE-LDAP
 ipv4 10.70.70.10
 base-dn dc=example,dc=invalid
 bind authenticate root-dn cn=network-service,ou=services,dc=example,dc=invalid password LDAPBindPassword
!
! ============================================================
! SPECIAL-CHARACTER TORTURE TESTS
! ============================================================
!
username special1 privilege 15 secret 0 P@ssw0rd!
username special2 privilege 15 secret 0 Test-Password_123
username special3 privilege 15 secret 0 Cisco$Parser#Test
username special4 privilege 15 secret 0 This.Is+A/Test=Password
!
radius server SPECIAL-RADIUS
 address ipv4 192.0.2.200
 key 0 R@dius-Key_123!#$%
!
tacacs server SPECIAL-TACACS
 address ipv4 192.0.2.201
 key 0 T@cacs+Secret_123!
!
key chain SPECIAL-KEYCHAIN
 key 1
  key-string AComplex_Key-With.Special+Characters
!
end